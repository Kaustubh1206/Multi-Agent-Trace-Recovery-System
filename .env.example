# Use your Groq key here; the client uses the OpenAI-compatible variable name.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
RETAIL_MODEL=openai/gpt-oss-120b
# JSON text validated locally; avoids provider-specific JSON Schema restrictions.
RETAIL_OUTPUT_METHOD=json
# For a provider with native schema support, choose json_schema instead.
