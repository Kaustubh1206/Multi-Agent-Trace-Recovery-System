# OpenAI provider. Put your own OpenAI API key in the local .env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RETAIL_MODEL=gpt-6-luna
RETAIL_REASONING_EFFORT=none
# JSON text validated locally against our Pydantic schemas.
RETAIL_OUTPUT_METHOD=json
# For a provider with native schema support, choose json_schema instead.

# Official automatic customer simulator (separate from the MAS model above).
RETAIL_USER_MODEL=gpt-4.1-2025-04-14
# Optional for reasoning models; setting this omits simulator temperature.
# RETAIL_USER_REASONING_EFFORT=none

# Optional experiment visualization (separate LangSmith API key).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=matrace-retail-custom
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# For an EU workspace: https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=your-workspace-id

# Logical MAS request budget per conversation (simulator/judge are separate).
RETAIL_MAX_MODEL_CALLS=32
RETAIL_MAX_OUTPUT_TOKENS=1024
