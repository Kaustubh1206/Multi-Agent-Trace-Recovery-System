# OpenAI provider. Put your own OpenAI API key in the local .env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RETAIL_MODEL=gpt-6-luna
RETAIL_REASONING_EFFORT=none
# JSON text validated locally against our Pydantic schemas.
RETAIL_OUTPUT_METHOD=json
# For a provider with native schema support, choose json_schema instead.
